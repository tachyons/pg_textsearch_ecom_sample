<% content_for :title, "Your Cart" %>

<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex items-center justify-between pb-4 border-b border-slate-200/80">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Shopping Cart</h1>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">
        <%= @cart.total_items %> <%= "item".pluralize(@cart.total_items) %>
      </span>
    </div>
    <%= link_to root_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <span>Continue Shopping</span>
    <% end %>
  </div>

  <% if @cart.cart_items.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Cart Items List (Left Column) -->
      <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
        <div class="divide-y divide-slate-100">
          <% @cart.cart_items.each do |item| %>
            <div id="cart_item_<%= item.id %>" class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-slate-50/50 transition-colors">
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-16 h-16 flex-shrink-0 rounded-xl overflow-hidden bg-slate-50 border border-slate-200/60 flex items-center justify-center p-1">
                  <%= product_visual(item.product, size: :thumb) %>
                </div>
                <div class="min-w-0">
                  <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                    <%= item.product.brand.name %>
                  </div>
                  <%= link_to item.product.name, product_path(item.product.slug), data: { turbo_frame: "_top" }, class: "text-sm font-bold text-slate-900 hover:text-indigo-600 transition-colors truncate block" %>
                  <div class="text-xs text-slate-500 mt-0.5">
                    <%= number_to_currency(item.product.price_cents / 100.0) %> each
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-4 sm:gap-6 flex-shrink-0">
                <!-- Quantity form -->
                <div class="w-20">
                  <%= form_with model: [item.cart, item], url: cart_item_path(item), method: :patch, class: "inline-block" do |f| %>
                    <%= f.number_field :quantity, value: item.quantity, min: 1, max: [item.product.stock_count, 1].max,
                      class: "w-16 px-2 py-1.5 bg-slate-50 hover:bg-white text-center text-xs font-semibold text-slate-900 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition",
                      data: { action: "change->catalog-form#submit" } %>
                  <% end %>
                </div>

                <!-- Item total -->
                <div class="text-right w-24">
                  <div class="text-sm font-extrabold text-slate-900 tabular-nums">
                    <%= number_to_currency(item.total_price_cents / 100.0) %>
                  </div>
                </div>

                <!-- Remove button -->
                <div>
                  <%= button_to cart_item_path(item), method: :delete, class: "p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors cursor-pointer", title: "Remove item" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Order Summary Card (Right Column) -->
      <div class="lg:col-span-4 bg-white rounded-2xl border border-slate-200/80 p-5 shadow-2xs space-y-5 sticky top-24">
        <h2 class="text-sm font-bold text-slate-900 tracking-tight pb-3 border-b border-slate-100">Order Summary</h2>

        <div class="space-y-3 text-xs">
          <div class="flex justify-between text-slate-600">
            <span>Items Subtotal</span>
            <span class="font-semibold text-slate-900 tabular-nums"><%= number_to_currency(@cart.total_price_cents / 100.0) %></span>
          </div>

          <div class="flex justify-between text-slate-600">
            <span>Estimated Shipping</span>
            <span class="font-semibold text-emerald-600">FREE</span>
          </div>

          <div class="flex justify-between text-slate-600">
            <span>Estimated Tax</span>
            <span class="font-medium text-slate-500">Calculated at checkout</span>
          </div>

          <div class="pt-3 border-t border-slate-100 flex justify-between items-baseline">
            <span class="text-sm font-bold text-slate-900">Total</span>
            <span class="text-xl font-extrabold text-slate-900 tabular-nums">
              <%= number_to_currency(@cart.total_price_cents / 100.0) %>
            </span>
          </div>
        </div>

        <div class="pt-2 space-y-2.5">
          <button type="button" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold text-xs rounded-xl shadow-md hover:shadow-indigo-500/25 transition-all duration-150 flex items-center justify-center gap-2 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            <span>Proceed to Checkout</span>
          </button>

          <%= link_to root_path, class: "w-full py-2.5 bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs rounded-xl border border-slate-200 transition-colors flex items-center justify-center" do %>
            Continue Shopping
          <% end %>
        </div>

        <div class="pt-2 text-center text-[11px] text-slate-400 flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          <span>End-to-end encrypted checkout</span>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty Cart State -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-12 sm:p-16 text-center shadow-2xs max-w-lg mx-auto">
      <div class="w-20 h-20 rounded-3xl bg-indigo-50 mx-auto flex items-center justify-center text-indigo-600 mb-6">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
      </div>
      <h2 class="text-xl font-bold text-slate-900 mb-2">Your shopping cart is empty</h2>
      <p class="text-sm text-slate-500 mb-8 leading-relaxed">
        Explore our collection powered by PostgreSQL BM25 fast full-text search with instant disjunctive filtering.
      </p>
      <%= link_to root_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md transition-all duration-150" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <span>Explore Catalog</span>
      <% end %>
    </div>
  <% end %>
</div>
