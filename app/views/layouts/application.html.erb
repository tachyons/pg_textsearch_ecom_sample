<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · pg_textsearch Store" : "pg_textsearch · High Performance BM25 Ecommerce" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="pg_textsearch Store">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      code, kbd, samp, pre {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>

  <body class="bg-slate-50/70 text-slate-800 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white antialiased">
    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-slate-900 text-white text-xs py-2 px-4 border-b border-indigo-700/50">
      <div class="container mx-auto max-w-7xl flex items-center justify-between gap-4">
        <div class="flex items-center gap-2 font-medium">
          <span class="inline-flex items-center justify-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-500/30 text-indigo-200 border border-indigo-400/30">BM25</span>
          <span class="hidden sm:inline">Powered by PostgreSQL extension:</span>
          <a href="https://github.com/tachyons/pg_textsearch" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-indigo-200 transition-colors">pg_textsearch</a>
          <span class="text-indigo-300/80">· Real-time BM25 ranking & disjunctive facets</span>
        </div>
        <div class="flex items-center gap-3 text-indigo-200 text-xs">
          <a href="https://github.com/tachyons/pg_textsearch" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-white transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="bg-white/90 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-40 transition-shadow duration-200">
      <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-3.5">
        <div class="flex items-center justify-between gap-4 sm:gap-8">
          <!-- Logo & Brand -->
          <div class="flex items-center gap-3">
            <%= link_to root_path, class: "flex items-center gap-2.5 group" do %>
              <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-600 flex items-center justify-center text-white shadow-md shadow-indigo-500/20 group-hover:shadow-indigo-500/40 transition-all duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-lg font-bold tracking-tight text-slate-900 group-hover:text-indigo-600 transition-colors leading-none">
                  pg_textsearch
                </span>
                <span class="text-[11px] font-semibold tracking-wide text-indigo-600 uppercase mt-0.5">
                  Store Demo
                </span>
              </div>
            <% end %>
          </div>

          <!-- Live Search Bar -->
          <div class="flex-1 max-w-2xl hidden md:block">
            <%= render "products/search_bar" %>
          </div>

          <!-- Header Right Utilities -->
          <div class="flex items-center gap-3">
            <!-- Mobile Search toggle anchor -->
            <div class="md:hidden">
              <%= link_to root_path, class: "p-2 text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 transition-colors" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <% end %>
            </div>

            <!-- GitHub pill badge -->
            <a href="https://github.com/tachyons/pg_textsearch" target="_blank" rel="noopener" class="hidden lg:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200/80 rounded-xl transition-colors border border-slate-200">
              <svg class="w-4 h-4 text-slate-800" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
              <span>GitHub Repo</span>
            </a>

            <!-- Cart button with counter -->
            <%= link_to cart_path, class: "relative inline-flex items-center gap-2 px-3 py-2 text-slate-700 hover:text-indigo-600 bg-slate-50 hover:bg-indigo-50/60 rounded-xl border border-slate-200 transition-all duration-150 group", data: { turbo_frame: "_top" } do %>
              <div class="relative">
                <svg class="w-5 h-5 text-slate-600 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                <span id="cart_badge" class="absolute -top-1.5 -right-1.5 bg-indigo-600 text-white text-[10px] font-bold rounded-full h-4 min-w-4 px-1 flex items-center justify-center shadow-xs">
                  <%= current_cart.total_items %>
                </span>
              </div>
              <span class="text-xs font-semibold hidden sm:inline">Cart</span>
            <% end %>
          </div>
        </div>

        <!-- Mobile Search Input Bar (Visible only on small viewports) -->
        <div class="mt-3 md:hidden">
          <%= render "products/search_bar" %>
        </div>
      </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-1 container mx-auto max-w-7xl px-4 sm:px-6 py-6 sm:py-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200/80 mt-16 py-10 text-slate-500 text-sm">
      <div class="container mx-auto max-w-7xl px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-xs font-bold">
            ⚡
          </div>
          <div>
            <p class="font-semibold text-slate-800">pg_textsearch Demonstration Store</p>
            <p class="text-xs text-slate-400">PostgreSQL BM25 extension for high-performance retrieval and disjunctive faceting</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-6 text-xs font-medium">
          <a href="https://github.com/tachyons/pg_textsearch" target="_blank" rel="noopener" class="hover:text-indigo-600 transition-colors">Documentation</a>
          <a href="https://github.com/tachyons/pg_textsearch#readme" target="_blank" rel="noopener" class="hover:text-indigo-600 transition-colors">BM25 vs tsvector Benchmarks</a>
          <a href="https://github.com/tachyons/pg_textsearch/issues" target="_blank" rel="noopener" class="hover:text-indigo-600 transition-colors">Issues & Feedback</a>
          <%= link_to "Reset Filters", root_path, class: "hover:text-indigo-600 transition-colors" %>
        </div>
      </div>
    </footer>

    <!-- Flash toasts notification container -->
    <div id="flash_toasts" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2.5 max-w-sm pointer-events-none" data-turbo-permanent></div>
  </body>
</html>
