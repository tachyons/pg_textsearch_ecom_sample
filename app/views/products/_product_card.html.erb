<article class="group relative bg-white rounded-2xl border border-slate-200/80 hover:border-slate-300 shadow-2xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden">
  <!-- Visual Header Container -->
  <div class="relative bg-slate-50/50 p-3 pb-0">
    <%= link_to product_path(product.slug), data: { turbo_frame: "_top" }, class: "block overflow-hidden rounded-xl" do %>
      <%= product_visual(product, size: :card) %>
    <% end %>

    <!-- Floating Badges Overlay -->
    <div class="absolute top-5 left-5 right-5 flex items-start justify-between pointer-events-none gap-2">
      <!-- Label Tag -->
      <div class="flex flex-wrap gap-1">
        <% if product.labels.any? %>
          <% primary_label = product.labels.first %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold tracking-wide border shadow-2xs backdrop-blur-sm <%= label_badge_class(primary_label.color) %>">
            <%= primary_label.name %>
          </span>
        <% end %>
      </div>

      <!-- Stock Pill -->
      <div>
        <% if product.stock_count > 10 %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50/90 text-emerald-700 border border-emerald-200/80 shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            In stock
          </span>
        <% elsif product.stock_count > 0 %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50/90 text-amber-700 border border-amber-200/80 shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
            <%= product.stock_count %> left
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50/90 text-rose-700 border border-rose-200/80 shadow-2xs">
            Out of stock
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="p-4 flex-1 flex flex-col justify-between">
    <div>
      <!-- Brand & Category -->
      <div class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wider text-slate-400 uppercase mb-1">
        <span><%= product.brand.name %></span>
        <span class="text-slate-300">/</span>
        <span class="truncate"><%= product.category.name %></span>
      </div>

      <!-- Product Title -->
      <h3 class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-1 text-base tracking-tight leading-snug">
        <%= link_to product.name, product_path(product.slug), data: { turbo_frame: "_top" } %>
      </h3>

      <!-- Rating & Reviews -->
      <div class="mt-1.5 flex items-center">
        <%= render_rating_badge(product.rating_avg) %>
      </div>

      <!-- Highlight Snippet or Description -->
      <div class="mt-2.5 text-xs text-slate-500 line-clamp-2 leading-relaxed">
        <% if product.respond_to?(:pg_search_highlight) && product.pg_search_highlight.present? %>
          <%= sanitize(product.pg_search_highlight, tags: %w[mark]) %>
        <% else %>
          <%= product.description.presence || "High quality #{product.category.name.downcase} engineered for performance and durability." %>
        <% end %>
      </div>
    </div>

    <!-- Pricing and Action Footer -->
    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between gap-3">
      <div class="flex flex-col">
        <span class="text-[10px] uppercase font-semibold tracking-wider text-slate-400">Price</span>
        <span class="text-lg font-extrabold text-slate-900 tabular-nums tracking-tight">
          <%= number_to_currency(product.price_cents / 100.0) %>
        </span>
      </div>

      <div>
        <% if product.stock_count > 0 %>
          <%= button_to cart_items_path(product_id: product.id),
                method: :post,
                class: "inline-flex items-center gap-1.5 px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-xs font-semibold rounded-xl shadow-xs hover:shadow-indigo-500/25 transition-all duration-150 cursor-pointer" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add</span>
          <% end %>
        <% else %>
          <button type="button" disabled class="px-3.5 py-2 bg-slate-100 text-slate-400 text-xs font-medium rounded-xl cursor-not-allowed">
            Unavailable
          </button>
        <% end %>
      </div>
    </div>
  </div>
</article>
