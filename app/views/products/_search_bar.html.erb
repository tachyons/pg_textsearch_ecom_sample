<div data-controller="autocomplete"
     data-autocomplete-url-value="<%= autocomplete_products_path %>"
     data-action="click@window->autocomplete#hide keydown.esc->autocomplete#hide"
     class="relative w-full">
  <%= form_with url: products_path, method: :get, data: { controller: "catalog-form", action: "submit->catalog-form#submit" }, class: "w-full" do |form| %>
    <div class="relative flex items-center">
      <div class="absolute left-3.5 pointer-events-none text-slate-400 flex items-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <%= form.search_field :q,
        value: params[:q],
        placeholder: "Search with BM25 (e.g. \"iPhone\", \"noise cancellation\", \"titanium\")...",
        data: {
          autocomplete_target: "input",
          action: "input->autocomplete#search keydown->autocomplete#onKeydown"
        },
        autocomplete: "off",
        class: "w-full pl-10 pr-20 py-2 text-sm bg-slate-50/80 hover:bg-white focus:bg-white text-slate-900 placeholder:text-slate-400 border border-slate-200 focus:border-indigo-500 rounded-xl shadow-2xs focus:outline-none focus:ring-4 focus:ring-indigo-500/10 transition-all duration-150" %>

      <div class="absolute right-2.5 flex items-center gap-1.5">
        <button type="submit" class="p-1 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-slate-100 transition-colors cursor-pointer" title="Search catalog">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
        <kbd class="hidden sm:inline-flex items-center justify-center px-1.5 py-0.5 text-[10px] font-semibold text-slate-400 bg-white border border-slate-200 rounded shadow-2xs">
          /
        </kbd>
      </div>
    </div>

    <!-- Preserve existing filters when submitting search text -->
    <% Array(params[:category_ids]).each { |id| concat form.hidden_field(:category_ids, value: id, multiple: true) } %>
    <% Array(params[:brand_ids]).each { |id| concat form.hidden_field(:brand_ids, value: id, multiple: true) } %>
    <% Array(params[:label_ids]).each { |id| concat form.hidden_field(:label_ids, value: id, multiple: true) } %>
    <% if params[:price_bucket].present? %>
      <%= form.hidden_field :price_bucket, value: params[:price_bucket] %>
    <% end %>
    <% if params[:min_rating].present? %>
      <%= form.hidden_field :min_rating, value: params[:min_rating] %>
    <% end %>
    <% if params[:in_stock].present? %>
      <%= form.hidden_field :in_stock, value: params[:in_stock] %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "autocomplete_results",
        data: { autocomplete_target: "results" },
        class: "absolute z-50 left-0 right-0 mt-2 bg-white/95 backdrop-blur-xl shadow-xl rounded-2xl border border-slate-200/90 overflow-hidden hidden" %>
</div>
