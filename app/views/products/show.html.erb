<% content_for :title, @product.name %>

<div class="max-w-6xl mx-auto space-y-12">
  <!-- Breadcrumb Navigation -->
  <nav class="flex items-center gap-2 text-xs font-medium text-slate-500" aria-label="Breadcrumb">
    <%= link_to root_path, class: "hover:text-indigo-600 transition-colors flex items-center gap-1" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
      <span>Products</span>
    <% end %>
    <span class="text-slate-300">/</span>
    <%= link_to @product.category.name, products_path(category_ids: [@product.category_id]), class: "hover:text-indigo-600 transition-colors" %>
    <span class="text-slate-300">/</span>
    <%= link_to @product.brand.name, products_path(brand_ids: [@product.brand_id]), class: "hover:text-indigo-600 transition-colors" %>
    <span class="text-slate-300">/</span>
    <span class="text-slate-900 font-semibold truncate max-w-xs" aria-current="page"><%= @product.name %></span>
  </nav>

  <!-- Product Hero Section (2-Column) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <!-- Left Column: Visual Showcase -->
    <div class="lg:col-span-6 bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs relative overflow-hidden">
      <div class="relative rounded-2xl overflow-hidden">
        <%= product_visual(@product, size: :hero) %>

        <!-- Floating Badges -->
        <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
          <div class="flex flex-wrap gap-1.5">
            <% @product.labels.each do |label| %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border shadow-2xs backdrop-blur-sm <%= label_badge_class(label.color) %>">
                <%= label.name %>
              </span>
            <% end %>
          </div>

          <div>
            <% if @product.stock_count > 0 %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <%= @product.stock_count %> units in stock
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 shadow-2xs">
                Out of stock
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Details & Actions -->
    <div class="lg:col-span-6 space-y-6">
      <div>
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-600 mb-2">
          <span><%= @product.brand.name %></span>
          <span class="text-slate-300">·</span>
          <span><%= @product.category.name %></span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          <%= @product.name %>
        </h1>

        <!-- Rating & Review Count -->
        <div class="mt-3 flex items-center gap-3">
          <div class="flex items-center gap-1 text-amber-400">
            <%= render_star_icons(@product.rating_avg) %>
          </div>
          <span class="text-sm font-bold text-slate-800"><%= number_with_precision(@product.rating_avg, precision: 1) %></span>
          <span class="text-slate-300">·</span>
          <span class="text-xs text-slate-500 font-medium"><%= rating_count_estimate(@product.rating_avg) %> customer ratings</span>
        </div>
      </div>

      <!-- Price Card -->
      <div class="bg-slate-50/80 rounded-2xl border border-slate-200/80 p-5 flex items-baseline justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-1">Total Price</span>
          <div class="text-3xl font-extrabold text-slate-900 tracking-tight">
            <%= number_to_currency(@product.price_cents / 100.0) %>
          </div>
        </div>
        <div class="text-right text-xs text-emerald-600 font-medium">
          Free standard shipping included
        </div>
      </div>

      <!-- Product Description -->
      <div class="prose prose-slate text-slate-600 text-sm leading-relaxed">
        <%= simple_format(@product.description.presence || "No detailed description available for this product.") %>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-3 pt-2">
        <div class="flex gap-4">
          <% if @product.stock_count > 0 %>
            <%= button_to cart_items_path(product_id: @product.id),
                  method: :post,
                  class: "flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold rounded-2xl shadow-md hover:shadow-indigo-500/25 transition-all duration-150 cursor-pointer" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
              </svg>
              <span>Add to Cart</span>
            <% end %>
          <% else %>
            <button type="button" disabled class="flex-1 px-6 py-3.5 bg-slate-100 text-slate-400 font-semibold rounded-2xl cursor-not-allowed">
              Currently Out of Stock
            </button>
          <% end %>

          <%= link_to cart_path, class: "px-6 py-3.5 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold rounded-2xl shadow-2xs hover:border-slate-300 transition-colors inline-flex items-center justify-center" do %>
            View Cart
          <% end %>
        </div>
      </div>

      <!-- Specs & Technical Metadata Card -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-2xs space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Specifications & Index Data</h3>
          <span class="inline-flex items-center gap-1 text-[11px] font-mono text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md font-medium">
            BM25 Indexed
          </span>
        </div>

        <dl class="grid grid-cols-2 gap-x-4 gap-y-2.5 text-xs">
          <dt class="text-slate-400 font-medium">SKU</dt>
          <dd class="text-slate-800 font-mono font-medium"><%= @product.sku %></dd>

          <dt class="text-slate-400 font-medium">Brand</dt>
          <dd class="text-slate-800 font-medium"><%= @product.brand.name %></dd>

          <dt class="text-slate-400 font-medium">Category</dt>
          <dd class="text-slate-800 font-medium"><%= @product.category.name %></dd>

          <dt class="text-slate-400 font-medium">Popularity Score</dt>
          <dd class="text-slate-800 font-mono font-medium"><%= @product.popularity_score %></dd>

          <dt class="text-slate-400 font-medium">Full-Text Target</dt>
          <dd class="text-slate-800 font-mono text-[11px]">unaccent(search_text)</dd>
        </dl>
      </div>
    </div>
  </div>

  <!-- Related Products (BM25 Similarity) -->
  <% if @related_products.any? %>
    <div class="border-t border-slate-200/80 pt-10 space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">You May Also Like</h2>
          <p class="text-xs text-slate-500 mt-0.5">Discovered via BM25 similarity scoring across product descriptions</p>
        </div>
        <span class="text-xs font-semibold text-indigo-600">BM25 Similarity</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <% @related_products.each do |product| %>
          <%= render "product_card", product: product %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
